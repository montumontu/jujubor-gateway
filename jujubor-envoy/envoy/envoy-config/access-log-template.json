{
    "access_log": [
      {
        "name": "envoy.access_loggers.stdout",
        "typed_config": {
          "@type": "type.googleapis.com/envoy.extensions.access_loggers.stream.v3.StdoutAccessLog",
          "log_format": {
            "json_format": {
              "@timestamp": "%START_TIME%",
              "envoy": {
                "downstream": {
                  "localaddress": "%DOWNSTREAM_LOCAL_ADDRESS%",
                  "remoteaddress": "%DOWNSTREAM_REMOTE_ADDRESS%"
                },
                "upstream": {
                  "cluster": "%UPSTREAM_CLUSTER%",
                  "remoteaddress": "%UPSTREAM_REMOTE_ADDRESS%",
                  "transport_failure_reason": "%UPSTREAM_TRANSPORT_FAILURE_REASON%"
                }
              },
              "host": {
                "hostname": "%HOSTNAME%"
              },
              "auth": {
                "id-token-audience": "%REQ(X-FP-ID-JWT-AUDIENCE)%",
                "access-token-audience": "%REQ(X-FP-ACCESS-JWT-AUDIENCE)%"
              },
              "http": {
                "request": {
                  "headers": {
                    "x-forwarded-for": "%REQ(X-FORWARDED-FOR)%",
                    "authority": "%REQ(:AUTHORITY)%",
                    "host": "%REQ(HOST)%",
                    "referer": "%REQ(REFERER)%",
                    "id": "%REQ(X-REQUEST-ID)%"
                  },
                  "method": "%REQ(:METHOD)%",
                  "path": "%REQ(X-ENVOY-ORIGINAL-PATH?:PATH)%"
                },
                "response": {
                  "code": "%RESPONSE_CODE%",
                  "flags": "%RESPONSE_FLAGS%",
                  "details": "%RESPONSE_CODE_DETAILS%",
                  "duration": "%DURATION%",
                  "upstream-service-time": "%RESP(X-ENVOY-UPSTREAM-SERVICE-TIME)%"
                }
              },
              "service": {
                "name": "envoy",
                "release": "X.X.X",
                "env": "dev"
              },
              "user_agent.name": "%REQ(USER-AGENT)%"
            }
          }
        }
      }
    ]
  }